exports[`output of every command, text and --json > unknown command > json 1`] = `
"exit 2
{
  "ok": false,
  "refusal": "norn runs work through the SDD process. Commands on an issue take its number explicitly.\\n\\n  norn init                          Set up this project: skills, .agents/specs/, labels\\n  norn next <story>                  What can be done on the story now\\n  norn take <issue> [--takeover]     Claim the issue and get the briefing for its step;\\n                                     --takeover takes it from a stopped session of yours\\n  norn done <issue> [outcome] [\\"note\\"] [--evidence <dir>]\\n                                     Finish the step; norn makes the transition.\\n                                     --evidence attaches the QA files in <dir>\\n  norn add-slice <story> \\"title\\" --mode afk|hil [--blocked-by <issue>]...\\n  norn escalate <issue> \\"reason\\" [--wait]\\n                                     Set needs-human and release the claim; with --wait,\\n                                     keep it and wait in this session for the answer\\n  norn resume <issue> \\"answer\\"       Record the answer to escalate --wait and carry on\\n  norn release <issue>               Give up the claim without a transition\\n  norn status <story>                Read-only overview of the story and its slices\\n  norn tidy [--dry-run]              Remove what belongs to closed issues\\n  norn dashboard [--port <n>] [--interval <duration>] [--no-open]\\n                                     Watch your work in the browser; Ctrl-C stops it\\n  norn doctor                        Check the whole setup and say what to fix\\n  norn flows export <name>           Copy a built-in flow to .agents/flows/<name>.json to change it\\n  norn --version                     Print the running norn's version\\n  norn --help                        Print this help; so does --help after any command\\n\\nAdd --json for machine-readable output."
}"
`;

exports[`output of every command, text and --json > unknown command > text 1`] = `
"exit 2
norn runs work through the SDD process. Commands on an issue take its number explicitly.

  norn init                          Set up this project: skills, .agents/specs/, labels
  norn next <story>                  What can be done on the story now
  norn take <issue> [--takeover]     Claim the issue and get the briefing for its step;
                                     --takeover takes it from a stopped session of yours
  norn done <issue> [outcome] ["note"] [--evidence <dir>]
                                     Finish the step; norn makes the transition.
                                     --evidence attaches the QA files in <dir>
  norn add-slice <story> "title" --mode afk|hil [--blocked-by <issue>]...
  norn escalate <issue> "reason" [--wait]
                                     Set needs-human and release the claim; with --wait,
                                     keep it and wait in this session for the answer
  norn resume <issue> "answer"       Record the answer to escalate --wait and carry on
  norn release <issue>               Give up the claim without a transition
  norn status <story>                Read-only overview of the story and its slices
  norn tidy [--dry-run]              Remove what belongs to closed issues
  norn dashboard [--port <n>] [--interval <duration>] [--no-open]
                                     Watch your work in the browser; Ctrl-C stops it
  norn doctor                        Check the whole setup and say what to fix
  norn flows export <name>           Copy a built-in flow to .agents/flows/<name>.json to change it
  norn --version                     Print the running norn's version
  norn --help                        Print this help; so does --help after any command

Add --json for machine-readable output."
`;

