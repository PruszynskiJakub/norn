{
  "name": "norn",
  "version": "0.6.0",
  "description": "CLI for the SDD process: GitHub labels as the only source of truth",
  "type": "module",
  "bin": {
    "norn": "dist/bin.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:ui -w @norn/web && node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.20.5",
    "esbuild": "0.25.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
